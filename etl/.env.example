DATABASE_URL=postgresql://postgres:password@localhost:5432/senal_dev

# Privacidad
K_ANONYMITY_THRESHOLD=5       # mínimo de registros para publicar una celda

# Rendimiento
ETL_BATCH_SIZE=1000            # registros por batch en cada insert
ETL_INCREMENTAL_LOOKBACK_H=2   # horas hacia atrás que cubre el job incremental

# Comportamiento
DRY_RUN=false                  # true = leer y transformar pero NO insertar
LOG_LEVEL=INFO
LOG_FORMAT=text                # text | json
