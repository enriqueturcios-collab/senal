NODE_ENV=development
PORT=3001

# PostgreSQL — base transaccional
DATABASE_URL=postgresql://postgres:password@localhost:5432/senal_dev

# Configuración del servidor
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000,https://dashboard.senal.app

# Seguridad
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# Rate limiting global (requests por minuto por IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
