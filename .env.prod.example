# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=senal_prod
POSTGRES_USER=senal
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── API B2B ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://dashboard.senal.app
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Portal bancario ───────────────────────────────────────────────────────────
PORTAL_URL=https://dashboard.senal.app
PORTAL_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── Marketplace app ───────────────────────────────────────────────────────────
APP_URL=https://app.senal.app
APP_NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32_different

# ── ETL ───────────────────────────────────────────────────────────────────────
K_ANONYMITY_THRESHOLD=5
ETL_BATCH_SIZE=1000
ETL_INCREMENTAL_LOOKBACK_H=2
LOG_LEVEL=INFO
